# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma separated list of allowed origins, or * for any
CORS_ORIGIN=*

# ---- PostgreSQL ----
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
DATABASE_POOL_MAX=10
# Set to true when connecting to managed Postgres that requires TLS
DATABASE_SSL=false

# ---- Firebase / Firestore ----
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option 1: path to a service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Option 2: inline service account credentials (keep the \n escapes in the key)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Option 3: local emulator (no credentials needed)
# FIRESTORE_EMULATOR_HOST=localhost:8080
